+on:
+  push:
+  pull_request:
+    branches: [main]
+
+name: CI
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out code
+        uses: actions/checkout@v4
+
+      - name: Set up Python 3.12
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements.txt
+
+      # Tests build their own small data and model, so no DVC pull is needed.
+      - name: Run tests
+        run: pytest -v
+
+  docker:
+    runs-on: ubuntu-latest
+    needs: test
+    steps:
+      - name: Check out code
+        uses: actions/checkout@v4
+
+      - name: Check the model artifact is committed
+        id: model
+        run: |
+          if [ -f models/model.joblib ]; then echo "present=true" >> "$GITHUB_OUTPUT"; else echo "present=false" >> "$GITHUB_OUTPUT"; echo "::warning::models/model.joblib not found - skipping Docker build"; fi
+
+      - name: Build Docker image
+        if: steps.model.outputs.present == 'true'
+        run: docker build -t mp236-api:1.0 .
+
+      - name: Smoke-test the container
+        if: steps.model.outputs.present == 'true'
+        run: |
+          docker run -d --rm --name mp236 -p 8000:8000 mp236-api:1.0
+          for i in $(seq 1 30); do
+            curl -sf http://127.0.0.1:8000/health && break
+            sleep 2
+          done
+          curl -sf http://127.0.0.1:8000/health | grep '"status":"ok"'
+          docker logs mp236
+          docker stop mp236
